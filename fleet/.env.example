# Copier vers ~/.iakafleet/.env (meme chemin sous macOS, Windows et Linux).
# Les variables d'environnement priment sur ce fichier. AUCUNE valeur secrete ici.
# Lu par le demon (fleet/), la CLI, le publieur de hooks (IAKA_NODE seulement) et l'app Monitor.
IAKAFLEET_MQTT_URL=
IAKA_NODE=
IAKAFLEET_HOST=
IAKAFLEET_AGENT_USER=
IAKAFLEET_AGENT_PASS=
IAKAFLEET_CONSOLE_USER=
IAKAFLEET_CONSOLE_PASS=
IAKAFLEET_SESSIONS_DIR=
IAKAFLEET_CARDS_DIR=
IAKAFLEET_SCAN_S=
IAKAFLEET_HEARTBEAT_S=
IAKAFLEET_IAKAFRAME_PKG=
IAKA_MASK_NAMES=
IAKA_SHOW_TASKS=
