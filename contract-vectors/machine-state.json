{
  "_doc": "Contrat par. 6 : regle d'etat de machine (instruction de fusion D4, ex D9 du MVP Fleet). meta = codes de presence/ (code -> {v,t}) ; nowS = maintenant (epoch s). state parmi online|mute|offline|unknown ; since = epoch s ou null ; basis = null sauf offline, \"last_seen\" (max(online.t, last_tick_at.v), dernier signe de vie) ou \"connected\" (repli sur online.t : last_tick_at absent ou illisible). alerts : libelles francais affiches (CLI et app). Une machine sans code online est INCONNUE, jamais hors ligne.",
  "cases": [
    { "name": "en ligne : battement recent", "nowS": 10000, "meta": { "online": {"v": true, "t": 9000}, "heartbeat_s": {"v": 60, "t": 9000}, "last_tick_at": {"v": 9970, "t": 9970} }, "expected": { "state": "online", "since": 9000, "basis": null, "alerts": [] } },
    { "name": "limite 3 x heartbeat incluse", "nowS": 10000, "meta": { "online": {"v": true, "t": 1}, "heartbeat_s": {"v": 10, "t": 1}, "last_tick_at": {"v": 9970, "t": 9970} }, "expected": { "state": "online", "since": 1, "basis": null, "alerts": [] } },
    { "name": "limite depassee de 1 s => muette", "nowS": 10000, "meta": { "online": {"v": true, "t": 1}, "heartbeat_s": {"v": 10, "t": 1}, "last_tick_at": {"v": 9969, "t": 9969} }, "expected": { "state": "mute", "since": 9969, "basis": null, "alerts": [] } },
    { "name": "online sans last_tick_at => muette, jamais en ligne", "nowS": 10000, "meta": { "online": {"v": true, "t": 9500} }, "expected": { "state": "mute", "since": 9500, "basis": null, "alerts": [] } },
    { "name": "heartbeat absent => defaut 60 s", "nowS": 10000, "meta": { "online": {"v": true, "t": 1}, "last_tick_at": {"v": 9820, "t": 9820} }, "expected": { "state": "online", "since": 1, "basis": null, "alerts": [] } },
    { "name": "heartbeat invalide (0) => defaut 60 s", "nowS": 10000, "meta": { "online": {"v": true, "t": 1}, "heartbeat_s": {"v": 0, "t": 1}, "last_tick_at": {"v": 9821, "t": 9821} }, "expected": { "state": "online", "since": 1, "basis": null, "alerts": [] } },
    { "name": "hors ligne (testament)", "nowS": 10000, "meta": { "online": {"v": false, "t": 2800} }, "expected": { "state": "offline", "since": 2800, "basis": "connected", "alerts": [] } },
    { "name": "testament apres longue vie : dernier battement, pas le demarrage", "nowS": 10000, "meta": { "online": {"v": false, "t": 1000}, "last_tick_at": {"v": 9950, "t": 9950} }, "expected": { "state": "offline", "since": 9950, "basis": "last_seen", "alerts": [] } },
    { "name": "arret propre : t de l arret posterieur au dernier battement", "nowS": 10000, "meta": { "online": {"v": false, "t": 9990}, "last_tick_at": {"v": 9950, "t": 9950} }, "expected": { "state": "offline", "since": 9990, "basis": "last_seen", "alerts": [] } },
    { "name": "hors ligne, last_tick_at illisible : repli sur la connexion", "nowS": 10000, "meta": { "online": {"v": false, "t": 2800}, "last_tick_at": {"v": "x", "t": 9950} }, "expected": { "state": "offline", "since": 2800, "basis": "connected", "alerts": [] } },
    { "name": "inconnue : pas de code online", "nowS": 10000, "meta": { "os": {"v": "linux", "t": 1} }, "expected": { "state": "unknown", "since": null, "basis": null, "alerts": [] } },
    { "name": "inconnue : online illisible (chaine)", "nowS": 10000, "meta": { "online": {"v": "oui", "t": 1} }, "expected": { "state": "unknown", "since": null, "basis": null, "alerts": [] } },
    { "name": "sessions illisibles", "nowS": 10000, "meta": { "online": {"v": true, "t": 1}, "heartbeat_s": {"v": 60, "t": 1}, "last_tick_at": {"v": 9999, "t": 9999}, "sessions_dir_ok": {"v": false, "t": 9999} }, "expected": { "state": "online", "since": 1, "basis": null, "alerts": ["sessions illisibles"] } },
    { "name": "aucune source de fiches (hooks non installes)", "nowS": 10000, "meta": { "online": {"v": true, "t": 1}, "heartbeat_s": {"v": 60, "t": 1}, "last_tick_at": {"v": 9999, "t": 9999}, "cards_source_ok": {"v": false, "t": 9999} }, "expected": { "state": "online", "since": 1, "basis": null, "alerts": ["fiches d'agents : aucune source sur cette machine"] } },
    { "name": "cards_source_ok absent : pas d'alerte inventee", "nowS": 10000, "meta": { "online": {"v": true, "t": 1}, "heartbeat_s": {"v": 60, "t": 1}, "last_tick_at": {"v": 9999, "t": 9999} }, "expected": { "state": "online", "since": 1, "basis": null, "alerts": [] } },
    { "name": "les deux alertes, ordre fixe", "nowS": 10000, "meta": { "online": {"v": true, "t": 1}, "heartbeat_s": {"v": 60, "t": 1}, "last_tick_at": {"v": 9999, "t": 9999}, "sessions_dir_ok": {"v": false, "t": 9999}, "cards_source_ok": {"v": false, "t": 9999} }, "expected": { "state": "online", "since": 1, "basis": null, "alerts": ["sessions illisibles", "fiches d'agents : aucune source sur cette machine"] } }
  ]
}
